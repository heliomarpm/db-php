{
  "name": "heliomarpm/db-php",
  "description": "Uma única API para PDO e MySQLi.Para PHP 8.2+, com suporte universal a parâmetros nomeados, paginação, telemetria nativa e zero dependências.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Heliomar P. Marques",
      "email": "heliomarpm@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/heliomarpm/db-php/issues",
    "source": "https://github.com/heliomarpm/db-php"
  },
  "keywords": [
    "database",
    "pdo",
    "mysqli",
    "db",
    "sql",
    "query",
    "lightweight",
    "php-library"
  ],
  "autoload": {
    "psr-4": {
      "HeliomarPM\\DbPHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HeliomarPM\\DbPHP\\Tests\\": "tests/",
      "Demo\\": "demo/"
    }
  },
  "scripts": {
    "format": "pint --test --parallel --max-processes=4",
    "format:fix": "pint --parallel --max-processes=4 --repair --dirty",
    "format:full": "pint --parallel --max-processes=4 --repair",
    "format:def": "pint --preset=psr12 --parallel --max-processes=4 --repair",
    "lint": "phpstan analyse",
    "test": "phpunit --configuration phpunit.xml --colors=always",
    "start": "php -S localhost:8000 demo/index.php",
    "check": [
      "@format",
      "@lint",
      "@test"
    ]
  },
  "suggest": {
    "heliomarpm/linq-php": "Permite encadear operações LINQ em memória a partir dos resultados de queries via ->linq()"
  },
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "phpstan/phpstan": "*",
    "laravel/pint": "^1.24 || ^1.32",
    "heliomarpm/linq-php": "^2.1"
  }
}