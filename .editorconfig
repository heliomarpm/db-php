# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160
quote_type = single

[*.{js,ts,html}]
indent_style = tab
quote_type = double

[*.{php,html}]
indent_size = 4
quote_type = double

[*.{sql}]
insert_final_newline = false
max_line_length = off

[*.{md,sh}]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yml,yaml,cff}]
trim_trailing_whitespace = false
max_line_length = off
